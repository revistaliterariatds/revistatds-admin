---
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />

    <!--
      CSP del panel.
      script-src SIN 'unsafe-inline': el único script inline es el de la nav
      (is:inline) y se permite por hash SHA-256. El guard `postbuild`
      (scripts/verify-csp.mjs) falla el build si aparece un script inline sin
      su hash — si tocás ese script, regenerá el hash y actualizalo acá.
      style-src mantiene 'unsafe-inline': el HTML generado desde JS usa
      atributos style="…" puntuales (hashes de atributo no son prácticos acá).
    -->
    <meta http-equiv="Content-Security-Policy" content="
      default-src 'self';
      script-src 'self' 'sha256-vH4OhMgfQBYV753gvtwEfe52k/el3tGK8UiGLHT2bOE=' https://accounts.google.com https://static.cloudflareinsights.com;
      style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com;
      font-src 'self' https://fonts.gstatic.com;
      img-src 'self' data: https://tramasdelsur.com.ar;
      connect-src 'self' https://script.google.com https://script.googleusercontent.com https://accounts.google.com;
      frame-src https://accounts.google.com https://tramasdelsur.com.ar;
      object-src 'none';
      base-uri 'self';
      form-action 'self';
    " />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lato:wght@300;400&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <nav aria-label="Navegación del panel">
      <div class="nav-inner">
        <a href="/" class="nav-logo" aria-label="Tramas del Sur — Panel editorial">
          <img src="/assets/img/logo/logo.jpeg" alt="Tramas del Sur" />
        </a>
        <div class="nav-user" id="nav-user" hidden>
          <div class="nav-links">
            <a href="/tablero/">Tablero</a>
            <a href="/agenda/">Agenda</a>
            <a href="/revistas/">Revistas</a>
            <a href="/usuarios/" id="nav-users" data-admin-tab hidden>Usuarios</a>
            <a href="/configuracion/" id="nav-config" data-admin-tab hidden>Configuración</a>
            <a href="/analiticas/" id="nav-analytics" data-admin-tab hidden>Visitas</a>
            <a href="/actividad/" id="nav-actividad" data-admin-tab hidden>Actividad</a>
            <a href="/descargas/" id="nav-descargas" data-admin-tab hidden>Descargas</a>
            <a href="/ediciones/" id="nav-ediciones" data-admin-only-tab hidden>Ediciones</a>
          </div>
          <span id="nav-user-name"></span>
          <span class="badge" id="nav-user-role"></span>
          <button id="nav-logout" class="btn-ghost" type="button">Salir</button>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-logo">
          <img src="/assets/img/logo/logo.jpeg" alt="Tramas del Sur" />
        </div>
        <span class="footer-copy">Revista literaria independiente</span>
        <div class="footer-qr">
          <a href="https://shcdigital.net.ar" target="_blank" rel="noopener noreferrer">
            <img src="/assets/img/logo/qr.png" alt="Código QR para acceder a SHC Digital" />
            <span>Diseño web by SHC.Digital</span>
          </a>
        </div>
      </div>
    </footer>

    <script is:inline>
      const sessionUser = (() => { try { return JSON.parse(sessionStorage.getItem('tds_user') || 'null'); } catch { return null; } })();
      const canSeeAdminTabs = ['COORDINADOR', 'WEBMASTER', 'SUPERVISOR'].includes(sessionUser?.rol);
      const canManageEdiciones = ['COORDINADOR', 'WEBMASTER'].includes(sessionUser?.rol);
      document.querySelectorAll('[data-admin-tab]').forEach((link) => { link.hidden = !canSeeAdminTabs; });
      document.querySelectorAll('[data-admin-only-tab]').forEach((link) => { link.hidden = !canManageEdiciones; });
      document.querySelectorAll('.nav-links a').forEach((link) => {
        if (link.pathname === window.location.pathname) link.setAttribute('aria-current', 'page');
      });
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js', { updateViaCache: 'none' });
      }
    </script>
  </body>
</html>
