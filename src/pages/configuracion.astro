---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Configuración — Tramas del Sur" description="Configuración del panel editorial.">
  <section class="users-page" aria-labelledby="config-heading">
    <header class="board-header">
      <div><p class="board-eyebrow">Administración</p><h1 id="config-heading">Configuración</h1></div>
    </header>
    <div id="config-alert" class="status-card" hidden></div>
    <form id="config-form" class="user-form" hidden>
      <div class="form-group"><label for="config-expira">Duración de links de autor (días)</label><input id="config-expira" type="number" min="1" max="365" required /><small>Entre 1 y 365 días.</small></div>
      <div class="form-group"><label for="config-convocatoria">Convocatoria actual</label><select id="config-convocatoria"><option value="general">General</option><option value="docentes">Docentes</option></select></div>
      <div class="form-group"><label for="config-site">URL base del sitio</label><input id="config-site" type="url" required /><small>Debe usar HTTPS.</small></div>
      <h2 class="detail-sub">Asuntos de mail</h2>
      <p class="form-help">Variables disponibles: <code>{'{{titulo}}'}</code>.</p>
      <div class="form-group"><label for="mail-subject-confirmation">Confirmación de envío</label><input id="mail-subject-confirmation" type="text" maxlength="200" required /></div>
      <div class="form-group"><label for="mail-subject-correcciones">Correcciones solicitadas</label><input id="mail-subject-correcciones" type="text" maxlength="200" required /></div>
      <div class="form-group"><label for="mail-subject-revision">Revisión terminada</label><input id="mail-subject-revision" type="text" maxlength="200" required /></div>
      <div class="form-group"><label for="mail-subject-consulta">Consulta al autor</label><input id="mail-subject-consulta" type="text" maxlength="200" required /></div>
      <div class="form-group"><label for="mail-subject-version">Nueva versión</label><input id="mail-subject-version" type="text" maxlength="200" required /></div>
      <div class="form-group"><label for="mail-subject-devolucion">Devolución al editor</label><input id="mail-subject-devolucion" type="text" maxlength="200" required /></div>
      <button class="btn-primary" type="submit">Guardar configuración</button>
    </form>
  </section>
</Layout>

<script>
  import '../scripts/configuracion.ts';
</script>
