---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Tablero — Tramas del Sur"
  description="Tablero editorial de Tramas del Sur."
>
  <section class="board" aria-labelledby="board-heading">
    <header class="board-header">
      <div>
        <p class="board-eyebrow">Redacción</p>
        <h1 id="board-heading">Tablero</h1>
      </div>
      <div class="board-tools">
        <input
          type="search"
          id="buscador"
          class="board-search"
          placeholder="Buscar título o autor…"
          aria-label="Buscar título o autor"
        />
        <button id="btn-refrescar" class="btn-ghost" type="button">Refrescar</button>
      </div>
    </header>

    <div class="filter-bar" aria-label="Filtros del tablero">
      <div class="filter-bar-head">
        <span class="filter-bar-title">Filtros</span>
        <button id="btn-limpiar-filtros" class="btn-mini" type="button">Limpiar filtros</button>
      </div>
      <div class="filter-group">
        <label class="filter-label" for="filtro-estado">Estado</label>
        <select id="filtro-estado" class="filter-select" aria-label="Filtrar por estado">
          <option value="TODOS">Todos los estados</option>
        </select>
      </div>
      <div class="filter-group">
        <label class="filter-label" for="filtro-convocatoria">Convocatoria</label>
        <select id="filtro-convocatoria" class="filter-select" aria-label="Filtrar por convocatoria">
          <option value="TODAS">Todas</option>
          <option value="general">General</option>
          <option value="docentes">Docentes</option>
        </select>
      </div>
    </div>

    <div class="board-table-wrap">
      <table class="board-table">
        <thead>
          <tr>
            <th scope="col">Estado</th>
            <th scope="col">Cuento</th>
            <th scope="col">Autor</th>
            <th scope="col">Convocatoria</th>
            <th scope="col">Titular</th>
            <th scope="col">Recibido</th>
            <th scope="col" class="col-acciones">Acciones</th>
          </tr>
        </thead>
        <tbody id="boardBody"></tbody>
      </table>
    </div>

    <div class="board-empty" id="emptyState" hidden>
      <p>No hay cuentos que coincidan. Cuando llegue el primer envío, aparece acá.</p>
    </div>
  </section>

  <!-- Modal de detalle -->
  <dialog id="detailModal" class="detail-modal">
    <div class="detail-inner">
      <button id="btn-cerrar-detalle" class="detail-close" type="button" aria-label="Cerrar">×</button>
      <div id="detailContent"></div>
    </div>
  </dialog>
</Layout>

<script>
  import '../scripts/tablero.ts';
</script>
