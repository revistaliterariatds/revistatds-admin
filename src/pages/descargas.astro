---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Descargas — Tramas del Sur" description="Descargas de las ediciones del sitio.">
  <section class="users-page" aria-labelledby="descargas-heading">
    <header class="board-header">
      <div><p class="board-eyebrow">Sitio público</p><h1 id="descargas-heading">Descargas</h1></div>
      <label class="analytics-period">Período <select id="descargas-days"><option value="7">7 días</option><option value="1">Último día completo</option><option value="30">30 días</option><option value="90">90 días</option><option value="365">365 días</option><option value="all">Histórico completo</option></select></label>
    </header>
    <div id="descargas-alert" class="status-card" hidden></div>
    <div class="analytics-kpis" aria-label="Resumen de descargas">
      <article class="analytics-kpi"><span>Total del período</span><strong id="kpi-total-descargas">—</strong><small>clics en ediciones</small></article>
      <article class="analytics-kpi"><span>Lecturas</span><strong id="kpi-leer">—</strong><small>abrieron el PDF</small></article>
      <article class="analytics-kpi"><span>Descargas</span><strong id="kpi-descargar">—</strong><small>guardaron el PDF</small></article>
    </div>
    <div class="board-table-wrap">
      <table class="board-table">
        <thead><tr><th>Edición</th><th>Total de clics</th></tr></thead>
        <tbody id="descargas-body"></tbody>
      </table>
    </div>
    <div class="board-empty" id="descargas-empty" hidden>No hay descargas registradas para el período seleccionado.</div>
  </section>
</Layout>

<script>
  import '../scripts/descargas.ts';
</script>
