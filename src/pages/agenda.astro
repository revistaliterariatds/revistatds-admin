---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Agenda — Tramas del Sur" description="Agenda del equipo editorial de Tramas del Sur.">
  <section class="agenda-page" aria-labelledby="agenda-heading">
    <header class="board-header">
      <div>
        <p class="board-eyebrow">Redacción</p>
        <h1 id="agenda-heading">Agenda</h1>
        <p class="config-intro">Clic en un día para crear una cita o ver las existentes.</p>
      </div>
      <div class="board-tools">
        <button id="agenda-hoy" class="btn-ghost" type="button">Hoy</button>
        <button id="agenda-refrescar" class="btn-ghost" type="button">Refrescar</button>
        <button id="agenda-feriados" class="btn-ghost" type="button" hidden>Actualizar feriados</button>
        <button id="agenda-feriado-nuevo" class="btn-ghost" type="button" hidden>Agregar feriado</button>
      </div>
    </header>

    <div id="agenda-alert" class="status-card" hidden></div>

    <div class="agenda-layout">
      <div class="cal-card">
        <div class="cal-nav">
          <button id="cal-prev" class="btn-ghost" type="button" aria-label="Mes anterior">←</button>
          <h2 id="cal-titulo" class="cal-titulo">—</h2>
          <button id="cal-next" class="btn-ghost" type="button" aria-label="Mes siguiente">→</button>
        </div>
        <div class="cal-grid cal-head" aria-hidden="true">
          <span>Dom</span><span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span>
        </div>
        <div id="cal-grid" class="cal-grid" role="grid" aria-label="Calendario de citas"></div>
      </div>

      <aside class="cal-aside" aria-labelledby="proximas-heading">
        <p class="board-eyebrow">Agenda</p>
        <h2 id="proximas-heading" class="cal-aside-title">Próximas citas</h2>
        <ul id="proximas-list" class="proximas-list"></ul>
        <div class="cal-legend">
          <p class="config-kicker">Tipos</p>
          <ul id="tipo-leyenda" class="tipo-leyenda"></ul>
          <div id="feriados-propios" class="feriados-propios" hidden></div>
        </div>
      </aside>
    </div>
  </section>

  <!-- Modal principal: lista del día / detalle / formulario -->
  <dialog id="citaModal" class="detail-modal">
    <div class="detail-inner">
      <button id="btn-cerrar-cita" class="detail-close" type="button" aria-label="Cerrar">×</button>
      <div id="citaContent"></div>
    </div>
  </dialog>
</Layout>

<script>
  import '../scripts/agenda.ts';
</script>